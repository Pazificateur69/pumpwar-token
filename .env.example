# --- Réseau ---
# Devnet par défaut. Mainnet : https://api.mainnet-beta.solana.com (idéalement un RPC privé).
RPC_URL=https://api.devnet.solana.com
# Sert uniquement aux liens explorer : devnet | testnet | mainnet
NETWORK=devnet

# --- Déployeur ---
# Chemin vers le keypair (format solana-keygen / id.json = tableau d'octets).
# NE COMMITE JAMAIS ce fichier. Génère-le : solana-keygen new -o deployer.json
KEYPAIR_PATH=./deployer.json

# --- Metadata ---
# URL du JSON de metadata off-chain (voir metadata/pwar.json).
# Devnet : n'importe quelle URL publique (ex. ton bucket Supabase public).
# Mainnet : Arweave (immuable).
METADATA_URI=https://REMPLACE-MOI.example/pwar.json
